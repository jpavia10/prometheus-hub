{
  "about": "Fixture root queue for check_delivery unit proofs",
  "updated": "2026-11-19",
  "pillar": "hub",
  "agents": [
    {
      "id": "gemini",
      "name": "Gemini",
      "tasks": [
        {
          "id": "HUB-TST-01",
          "title": "Sample structured JSON task",
          "deliver": {
            "file": "hub_gemini_sample_{YYYYMMDD-HHMM}.json",
            "folder": "Prometheus Hub/Pillars/Prometheus Hub/incoming (AI drop files)/",
            "shape": "JSON array, one object per row"
          },
          "count": 2,
          "fields": [
            {
              "name": "n",
              "type": "integer",
              "rule": "row number"
            },
            {
              "name": "title",
              "type": "text",
              "rule": "short title"
            },
            {
              "name": "score",
              "type": "number",
              "rule": "decimal score"
            },
            {
              "name": "published",
              "type": "date YYYY-MM-DD",
              "rule": "publication date"
            },
            {
              "name": "url",
              "type": "URL",
              "rule": "canonical page URL"
            },
            {
              "name": "quote",
              "type": "text",
              "rule": "excerpt <= 300 chars"
            }
          ]
        },
        {
          "id": "HUB-TST-02",
          "title": "Open count JSON task",
          "deliver": {
            "file": "hub_gemini_open_{YYYYMMDD-HHMM}.json",
            "folder": "Prometheus Hub/Pillars/Prometheus Hub/incoming (AI drop files)/",
            "shape": "JSON array"
          },
          "count": 0,
          "fields": [
            {
              "name": "n",
              "type": "integer",
              "rule": "row"
            },
            {
              "name": "item",
              "type": "text",
              "rule": "item name"
            }
          ]
        },
        {
          "id": "HUB-TST-03",
          "title": "Markdown notes task",
          "deliver": {
            "file": "hub_gemini_notes_{YYYYMMDD-HHMM}.md",
            "folder": "Prometheus Hub/Pillars/Prometheus Hub/incoming (AI drop files)/",
            "shape": "Markdown document with headings: ## Summary, ## Findings, ## Sources"
          },
          "count": 0
        },
        {
          "id": "HUB-TST-04",
          "title": "Fixture: a function spec",
          "state": "now",
          "due": "2026-11-30",
          "deliver": {
            "file": "hub_gemini_function-spec_{YYYYMMDD-HHMM}.md",
            "folder": "Prometheus Hub/Pillars/Prometheus Hub/incoming (AI drop files)/",
            "shape": "one markdown file with exactly these headings, in this order: A What it does today | B What Joseph needs it to do | C Data | D Screens | E Rules and edge cases | F Acceptance tests | G Order of work | H Must not"
          },
          "count": 1,
          "fields": [
            {
              "name": "A What it does today",
              "type": "list",
              "rule": "each with file:line"
            },
            {
              "name": "B What Joseph needs it to do",
              "type": "8+ user stories",
              "rule": "'As Joseph, when ..., I want ..., so that ...'"
            },
            {
              "name": "C Data",
              "type": "table",
              "rule": "record | field | type | unit | required | example | storage key (prometheus.<pillar>.<name>) | read by which other pillar"
            },
            {
              "name": "D Screens",
              "type": "per screen",
              "rule": "purpose"
            },
            {
              "name": "E Rules and edge cases",
              "type": "10+",
              "rule": "dates"
            },
            {
              "name": "F Acceptance tests",
              "type": "12+",
              "rule": "Given / When / Then, each checkable in a phone browser"
            },
            {
              "name": "G Order of work",
              "type": "numbered steps",
              "rule": "small"
            },
            {
              "name": "H Must not",
              "type": "list",
              "rule": "charter"
            }
          ]
        },
        {
          "id": "HUB-TST-05",
          "title": "Object-shaped delivery (one station, twelve months)",
          "deliver": {
            "file": "hub_gemini_normals_{YYYYMMDD-HHMM}.json",
            "folder": "Prometheus Hub/Pillars/Prometheus Hub/incoming (AI drop files)/",
            "shape": "{station: {id, name}, columns: [...], months: [3 objects]}"
          },
          "count": 0,
          "fields": []
        },
        {
          "id": "HUB-TST-06",
          "title": "Fixture: a count written as a floor (2+)",
          "state": "now",
          "deliver": {
            "file": "hub_gemini_floor_{YYYYMMDD-HHMM}.json",
            "folder": "Prometheus Hub/Pillars/Prometheus Hub/incoming (AI drop files)/",
            "shape": "JSON array of 2+ objects"
          },
          "count": 2,
          "fields": [
            {
              "name": "n",
              "type": "integer",
              "rule": "row"
            },
            {
              "name": "item",
              "type": "text",
              "rule": "item name"
            }
          ]
        }
      ]
    }
  ]
}
