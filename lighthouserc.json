{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -u -m http.server 8377 --bind 127.0.0.1",
      "startServerReadyPattern": "Serving HTTP",
      "startServerReadyTimeout": 20000,
      "url": [
        "http://127.0.0.1:8377/",
        "http://127.0.0.1:8377/pillars/apollo/",
        "http://127.0.0.1:8377/pillars/athenaeum/",
        "http://127.0.0.1:8377/pillars/hearth/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "configPath": "tools/lighthouse/config.mjs",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.9}],
        "categories:performance": ["warn", {"minScore": 0.9}],
        "installable-manifest": ["error", {"minScore": 1}],
        "service-worker": ["error", {"minScore": 1}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
